<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dim" />

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_grip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stamp"
                style="@style/Stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO" />

            <TextView
                android:id="@+id/langInfo"
                style="@style/Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="FR ⇄ EN" />

            <TextView
                android:id="@+id/openCarnet"
                style="@style/Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carnet" />
        </LinearLayout>

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/archivo_regular"
            android:gravity="top|start"
            android:hint="Tape ou colle ton texte…"
            android:imeOptions="flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/soft"
            android:textSize="18sp" />

        <com.passeport.app.PerforationView
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/archivo_extrabold"
            android:hint="La traduction s’affiche ici"
            android:maxLines="8"
            android:minHeight="48dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            android:textColor="@color/navy"
            android:textColorHint="@color/line"
            android:textIsSelectable="true"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/plex_mono_regular"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/modeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_switch"
                android:orientation="horizontal"
                android:padding="1.5dp">

                <TextView
                    android:id="@+id/modeFast"
                    style="@style/Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rapide" />

                <TextView
                    android:id="@+id/modePrecise"
                    style="@style/Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Précis" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/clear"
                style="@style/Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Effacer"
                android:textColor="@color/soft" />

            <TextView
                android:id="@+id/copy"
                style="@style/Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copier" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
