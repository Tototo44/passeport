<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Passeport" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/red</item>
        <item name="colorAccent">@color/navy</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/archivo_regular</item>
    </style>

    <!-- Les tiroirs : fenêtre transparente posée par-dessus l'écran en cours -->
    <style name="Theme.Passeport.Sheet">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Label">
        <item name="android:fontFamily">@font/plex_mono_semibold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/soft</item>
    </style>

    <style name="Link">
        <item name="android:fontFamily">@font/plex_mono_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Stamp">
        <item name="android:fontFamily">@font/plex_mono_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:background">@drawable/bg_stamp</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:rotation">-3</item>
    </style>

    <style name="Segment">
        <item name="android:fontFamily">@font/archivo_extrabold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="Heading">
        <item name="android:fontFamily">@font/archivo_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <style name="Body">
        <item name="android:fontFamily">@font/archivo_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
